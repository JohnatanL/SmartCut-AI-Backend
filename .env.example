# ==========================================
# Variables de Entorno - SmartCut AI Backend
# ==========================================
# Copia este archivo como '.env' para personalizar la configuración local:
# cp .env.example .env

# Clave secreta para la firma criptográfica de tokens JWT
SECRET_KEY=tu_clave_secreta_super_segura_aqui

# Algoritmo de firmado JWT
ALGORITHM=HS256

# Tiempo de expiración del token de acceso (en minutos)
ACCESS_TOKEN_EXPIRE_MINUTES=30
